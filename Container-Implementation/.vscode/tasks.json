{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "docker-build",
            "label": "docker-build",
            "platform": "python",
            "dockerBuild": {
                "tag": "containerimplementation:latest",
                "dockerfile": "${workspaceFolder}/backend/Dockerfile",
                "context": "${workspaceFolder}/backend",
                "pull": true
            }
        },
        {
            "type": "docker-run",
            "label": "docker-run: debug",
            "dependsOn": [
                "docker-build"
            ],
            "python": {
                "file": "backend\\manage.py"
            }
        },
        {
            "label": "Python: Run Django locally",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "${workspaceFolder}/backend/manage.py",
                "runserver",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}